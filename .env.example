# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_RECAPTCHA_V3_SITE_KEY: Optional Firebase / Google reCAPTCHA v3 Site Key for enterprise bot protection and Firebase App Check.
# Defaults to AppCheck/reCAPTCHA key or interactive visual CAPTCHA fallback.
VITE_RECAPTCHA_V3_SITE_KEY=""

# VITE_RECAPTCHA_ENTERPRISE_SITE_KEY: Google reCAPTCHA Enterprise Site Key for App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=""

# RECAPTCHA_SECRET_KEY: Google reCAPTCHA Secret Key (server-side verification).
RECAPTCHA_SECRET_KEY=""

# VITE_APPCHECK_DEBUG_TOKEN: Optional debug token for Firebase App Check testing in local/staging environments.
VITE_APPCHECK_DEBUG_TOKEN=""

# TWILIO_ACCOUNT_SID: Twilio Account SID for automated WhatsApp / SMS reminders.
TWILIO_ACCOUNT_SID=""

# TWILIO_AUTH_TOKEN: Twilio Auth Token for automated WhatsApp / SMS API.
TWILIO_AUTH_TOKEN=""

# TWILIO_WHATSAPP_NUMBER: Twilio WhatsApp sender phone number (e.g. +14155238886 or approved business number).
TWILIO_WHATSAPP_NUMBER="+14155238886"
